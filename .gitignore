firepit-log.txt
.firebase/
# Firebase client configuration is supplied explicitly through
# lib/firebase_options.dart plus --dart-define. Do not re-commit files
# regenerated by FlutterFire; they contain the same public client identifiers
# that trigger secret-scanning alerts and can bypass explicit initialization.
/android/app/google-services.json
/ios/Runner/GoogleService-Info.plist
/macos/Runner/GoogleService-Info.plist
build/operator_tokens/
build/user_exports/
build/operator_audit/
build/**/*.jsonl
