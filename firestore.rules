rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdminOrImporter() {
      return signedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.cdssImporter == true
      );
    }

    function safeId(value) {
      return value is string &&
        value.size() > 0 &&
        value.size() <= 160 &&
        value.matches('^[A-Za-z0-9._:-]+$');
    }

    function validString(key, maxSize) {
      return key in request.resource.data &&
        request.resource.data[key] is string &&
        request.resource.data[key].size() <= maxSize;
    }

    function optionalString(key, maxSize) {
      return !(key in request.resource.data) ||
        request.resource.data[key] == null ||
        (
          request.resource.data[key] is string &&
          request.resource.data[key].size() <= maxSize
        );
    }

    function optionalStringList(key, maxItems) {
      return !(key in request.resource.data) ||
        request.resource.data[key] == null ||
        (
          request.resource.data[key] is list &&
          request.resource.data[key].size() <= maxItems
        );
    }

    function optionalNumber(key) {
      return !(key in request.resource.data) ||
        request.resource.data[key] == null ||
        request.resource.data[key] is int ||
        request.resource.data[key] is float;
    }

    function optionalBool(key) {
      return !(key in request.resource.data) ||
        request.resource.data[key] == null ||
        request.resource.data[key] is bool;
    }

    function optionalTimestampOrString(key) {
      return !(key in request.resource.data) ||
        request.resource.data[key] == null ||
        request.resource.data[key] is timestamp ||
        (
          request.resource.data[key] is string &&
          request.resource.data[key].size() <= 80
        );
    }

    function optionalMap(key, maxKeys) {
      return !(key in request.resource.data) ||
        request.resource.data[key] == null ||
        (
          request.resource.data[key] is map &&
          request.resource.data[key].keys().size() <= maxKeys
        );
    }

    function validMedicationProductSelection(value) {
      return value is map &&
        value.keys().hasOnly([
          'packId',
          'identifierSystem',
          'identifierValue',
          'displayName',
          'labelerName',
          'strengthDisplay',
          'packageDescription',
          'doseBasisIngredient',
          'unitQuantity',
          'unitLabel',
        ]) &&
        value.packId is string && value.packId.size() > 0 && value.packId.size() <= 160 &&
        value.identifierSystem is string && value.identifierSystem.size() > 0 && value.identifierSystem.size() <= 48 &&
        value.identifierValue is string && value.identifierValue.size() > 0 && value.identifierValue.size() <= 160 &&
        value.displayName is string && value.displayName.size() > 0 && value.displayName.size() <= 240 &&
        value.strengthDisplay is string && value.strengthDisplay.size() <= 160 &&
        value.packageDescription is string && value.packageDescription.size() <= 240 &&
        (
          !('labelerName' in value) || value.labelerName == null ||
          (value.labelerName is string && value.labelerName.size() <= 160)
        ) &&
        (
          !('doseBasisIngredient' in value) || value.doseBasisIngredient == null ||
          (value.doseBasisIngredient is string && value.doseBasisIngredient.size() <= 160)
        ) &&
        (
          !('unitQuantity' in value) || value.unitQuantity == null ||
          (
            (value.unitQuantity is int || value.unitQuantity is float) &&
            value.unitQuantity > 0 && value.unitQuantity <= 1000000
          )
        ) &&
        (
          !('unitLabel' in value) || value.unitLabel == null ||
          (value.unitLabel is string && value.unitLabel.size() <= 48)
        );
    }

    function validDoseParsedExpression(value) {
      return value is map &&
        value.keys().hasOnly(['value', 'unit', 'role', 'source_span']) &&
        (value.value is int || value.value is float) &&
        value.value > 0 && value.value <= 1000000 &&
        value.role == 'administrationDose' &&
        value.unit is map &&
        value.unit.keys().hasOnly(['display', 'system', 'code', 'version', 'dimension']) &&
        value.unit.display is string && value.unit.display.size() > 0 && value.unit.display.size() <= 48 &&
        value.unit.system == 'urn:parkinsum:dose-unit' &&
        value.unit.code is string && value.unit.code.size() > 0 && value.unit.code.size() <= 16 &&
        value.unit.version is string && value.unit.version.size() > 0 && value.unit.version.size() <= 16 &&
        value.unit.dimension in ['mass', 'volume'] &&
        value.source_span is map &&
        value.source_span.keys().hasOnly(['start', 'end']) &&
        value.source_span.start is int && value.source_span.start >= 0 &&
        value.source_span.end is int && value.source_span.end > value.source_span.start &&
        value.source_span.end <= 256;
    }

    function validDoseConfirmation(value, intakeId) {
      return value is map &&
        value.keys().hasOnly([
          'schema_version',
          'receipt_id',
          'receipt_digest',
          'operation_id',
          'owner_scope_digest',
          'intake_id',
          'expected_record_revision_digest',
          'record_binding_digest',
          'medication_id',
          'product_snapshot_digest',
          'raw_expression',
          'parsed_expression',
          'grammar_id',
          'grammar_version',
          'grammar_digest',
          'unit_system',
          'unit_system_version',
          'structured_value',
          'structured_unit',
          'administration_at_utc',
          'confirmed_at_utc',
          'assertion_source',
          'confirmation_action',
          'ui_contract_version',
          'meaning_boundary',
        ]) &&
        value.schema_version == 1 &&
        safeId(value.operation_id) &&
        value.intake_id == intakeId &&
        safeId(value.medication_id) &&
        value.receipt_id is string && value.receipt_id.size() == 77 &&
        value.receipt_id.matches('^dose_receipt_[a-f0-9]{64}$') &&
        value.receipt_digest is string && value.receipt_digest.matches('^[a-f0-9]{64}$') &&
        value.owner_scope_digest is string && value.owner_scope_digest.matches('^[a-f0-9]{64}$') &&
        value.expected_record_revision_digest is string && value.expected_record_revision_digest.matches('^[a-f0-9]{64}$') &&
        value.record_binding_digest is string && value.record_binding_digest.matches('^[a-f0-9]{64}$') &&
        value.product_snapshot_digest is string && value.product_snapshot_digest.matches('^[a-f0-9]{64}$') &&
        value.grammar_digest is string && value.grammar_digest.matches('^[a-f0-9]{64}$') &&
        value.raw_expression is string && value.raw_expression.size() > 0 && value.raw_expression.size() <= 256 &&
        validDoseParsedExpression(value.parsed_expression) &&
        value.grammar_id == 'parkinsum.administration-dose-expression' &&
        value.grammar_version == 1 &&
        value.unit_system == 'urn:parkinsum:dose-unit' &&
        value.unit_system_version == '1' &&
        (value.structured_value is int || value.structured_value is float) &&
        value.structured_value > 0 && value.structured_value <= 1000000 &&
        value.structured_unit is string && value.structured_unit.size() > 0 && value.structured_unit.size() <= 16 &&
        value.administration_at_utc is string && value.administration_at_utc.size() <= 80 &&
        value.confirmed_at_utc is string && value.confirmed_at_utc.size() <= 80 &&
        value.assertion_source in ['typed', 'packageDerived', 'imported'] &&
        safeId(value.confirmation_action) &&
        safeId(value.ui_contract_version) &&
        value.meaning_boundary is string && value.meaning_boundary.size() <= 240;
    }

    function validMedicationReconciliation(value) {
      return value is map &&
        value.keys().hasOnly([
          'schema',
          'schemaVersion',
          'assertions',
          'decisions',
          'meaningBoundary',
        ]) &&
        value.schema == 'parkinsum.medication-reconciliation-envelope/1' &&
        value.schemaVersion == 1 &&
        value.assertions is list &&
        value.assertions.size() > 0 &&
        value.assertions.size() <= 64 &&
        value.decisions is list &&
        value.decisions.size() <= 128 &&
        value.meaningBoundary is string &&
        value.meaningBoundary.size() > 0 &&
        value.meaningBoundary.size() <= 240;
    }

    function validProfile(uid) {
      return request.resource.data.keys().hasOnly([
        'patientId',
        'registrationRegion',
        'displayLocale',
        'contentJurisdictionOverride',
        'dietProfileRegion',
        'timezone',
        'swallowingTextureMode',
        'localAiConsentEnabled',
        'consentReceipts',
        'consentReceiptLedgerBlocked',
        'legacyLocalAiConsentRequested',
        'localAiProviderPreference',
        'localAiModel',
        'localAiMedicalModel',
        'localAiOllamaEndpoint',
        'localAiOpenAiCompatEndpoint',
        'localAiTimeoutMs',
      ]) &&
      validString('patientId', 160) &&
      request.resource.data.patientId == uid &&
      validString('registrationRegion', 16) &&
      validString('displayLocale', 32) &&
      optionalStringList('contentJurisdictionOverride', 16) &&
      optionalString('dietProfileRegion', 16) &&
      validString('timezone', 64) &&
      validString('swallowingTextureMode', 48) &&
      optionalBool('localAiConsentEnabled') &&
      request.resource.data.consentReceipts is list &&
      request.resource.data.consentReceipts.size() <= 128 &&
      request.resource.data.consentReceiptLedgerBlocked is bool &&
      request.resource.data.legacyLocalAiConsentRequested is bool &&
      validString('localAiProviderPreference', 32) &&
      validString('localAiModel', 128) &&
      validString('localAiMedicalModel', 180) &&
      validString('localAiOllamaEndpoint', 160) &&
      validString('localAiOpenAiCompatEndpoint', 180) &&
      request.resource.data.localAiTimeoutMs is int &&
      request.resource.data.localAiTimeoutMs >= 1000 &&
      request.resource.data.localAiTimeoutMs <= 60000;
    }

    function validMeal(mealId) {
      return safeId(mealId) &&
      request.resource.data.keys().hasOnly([
        'id',
        'schemaVersion',
        'eatenAt',
        'recordedAt',
        'occurredAt',
        'occurredRangeStart',
        'occurredRangeEnd',
        'timeSource',
        'timePrecision',
        'nextMealWindowStart',
        'nextMealWindowEnd',
        'coeventTime',
        'coeventSubstanceTags',
        'thickenerType',
        'enteralFeedMode',
        'enteralFeedFormula',
        'enteralFeedProteinGPerDay',
        'title',
        'items',
        'eatenAtIso',
      ]) &&
      request.resource.data.id == mealId &&
      validString('eatenAt', 80) &&
      optionalString('recordedAt', 80) &&
      optionalString('occurredAt', 80) &&
      optionalString('occurredRangeStart', 80) &&
      optionalString('occurredRangeEnd', 80) &&
      optionalString('timeSource', 48) &&
      optionalString('timePrecision', 32) &&
      optionalString('nextMealWindowStart', 80) &&
      optionalString('nextMealWindowEnd', 80) &&
      optionalString('coeventTime', 80) &&
      optionalStringList('coeventSubstanceTags', 24) &&
      optionalString('thickenerType', 80) &&
      optionalString('enteralFeedMode', 80) &&
      optionalString('enteralFeedFormula', 160) &&
      optionalNumber('enteralFeedProteinGPerDay') &&
      validString('title', 240) &&
      request.resource.data.items is list &&
      request.resource.data.items.size() <= 50 &&
      optionalString('eatenAtIso', 80);
    }

    function validIntake(intakeId) {
      return safeId(intakeId) &&
      request.resource.data.keys().hasOnly([
        'id',
        'schemaVersion',
        'drugId',
        'takenAt',
        'dosageNote',
        'doseAmount',
        'doseUnit',
        'dosageForm',
        'route',
        'releaseType',
        'productSelection',
        'doseConfirmation',
        'medicationReconciliation',
        'takenAtIso',
      ]) &&
      request.resource.data.id == intakeId &&
      request.resource.data.schemaVersion in [1, 2, 3] &&
      validString('drugId', 160) &&
      validString('takenAt', 80) &&
      optionalString('dosageNote', 256) &&
      (
        !('doseAmount' in request.resource.data) ||
        request.resource.data.doseAmount == null ||
        (
          (request.resource.data.doseAmount is int || request.resource.data.doseAmount is float) &&
          request.resource.data.doseAmount > 0 &&
          request.resource.data.doseAmount <= 1000000
        )
      ) &&
      optionalString('doseUnit', 48) &&
      optionalString('dosageForm', 80) &&
      optionalString('route', 80) &&
      optionalString('releaseType', 80) &&
      (
        !('productSelection' in request.resource.data) ||
        request.resource.data.productSelection == null ||
        validMedicationProductSelection(request.resource.data.productSelection)
      ) &&
      (
        !('doseConfirmation' in request.resource.data) ||
        request.resource.data.doseConfirmation == null ||
        (
          request.resource.data.schemaVersion in [2, 3] &&
          validDoseConfirmation(request.resource.data.doseConfirmation, intakeId)
        )
      ) &&
      (
        !('medicationReconciliation' in request.resource.data) ||
        request.resource.data.medicationReconciliation == null ||
        (
          request.resource.data.schemaVersion == 3 &&
          validMedicationReconciliation(
            request.resource.data.medicationReconciliation
          )
        )
      ) &&
      optionalString('takenAtIso', 80);
    }

    function validActiveDrug(drugId) {
      return safeId(drugId) &&
        request.resource.data.keys().hasOnly(['id']) &&
        request.resource.data.id == drugId;
    }

    function validAppMeta(uid, key) {
      return safeId(key) &&
      request.resource.data.keys().hasOnly([
        'value',
        'operation_id',
        'stage',
        'schema_version',
        'probe_run_id',
        'owner_uid',
        'created_at',
        'purpose',
      ]) &&
      (
        !('value' in request.resource.data) ||
        request.resource.data.value is bool
      ) &&
      optionalString('probe_run_id', 160) &&
      optionalString('operation_id', 160) &&
      optionalString('stage', 32) &&
      (
        (
          !('operation_id' in request.resource.data) &&
          !('stage' in request.resource.data) &&
          !('schema_version' in request.resource.data)
        ) ||
        (
          safeId(request.resource.data.operation_id) &&
          request.resource.data.stage == 'committed' &&
          request.resource.data.schema_version == 1 &&
          request.resource.data.value == true &&
          request.resource.data.owner_uid == uid &&
          request.resource.data.purpose == 'atomic_onboarding_commit'
        )
      ) &&
      (
        !('owner_uid' in request.resource.data) ||
        request.resource.data.owner_uid == uid
      ) &&
      optionalTimestampOrString('created_at') &&
      optionalString('purpose', 160);
    }

    function validKv(key) {
      return safeId(key) &&
      request.resource.data.keys().hasOnly(['value', 'updated_at']) &&
      validString('value', 200000) &&
      optionalTimestampOrString('updated_at');
    }

    function validClinicalAudit(uid, auditId) {
      return safeId(auditId) &&
      request.resource.data.keys().hasOnly([
        'type',
        'meal_id',
        'patient_id',
        'registration_region',
        'display_locale',
        'diet_profile_region',
        'active_drug_ids',
        'intake_ids',
        'related_intakes',
        'meal',
        'result',
        'score',
        'severity',
        'generated_at',
        'intake_count',
        'meal_count',
        'decision_path',
        'explanations',
        'gate_reasons',
        'ai_used',
        'recommendations',
        'release_id',
        'redaction_contract',
        'created_at',
      ]) &&
      validString('type', 80) &&
      optionalString('meal_id', 160) &&
      optionalString('patient_id', 160) &&
      (
        !('patient_id' in request.resource.data) ||
        request.resource.data.patient_id == uid
      ) &&
      optionalString('registration_region', 16) &&
      optionalString('display_locale', 32) &&
      optionalString('diet_profile_region', 16) &&
      optionalStringList('active_drug_ids', 64) &&
      optionalStringList('intake_ids', 64) &&
      optionalStringList('explanations', 32) &&
      optionalStringList('gate_reasons', 32) &&
      optionalMap('meal', 32) &&
      optionalMap('result', 32) &&
      optionalNumber('score') &&
      optionalString('severity', 32) &&
      optionalTimestampOrString('generated_at') &&
      optionalNumber('intake_count') &&
      optionalNumber('meal_count') &&
      optionalString('decision_path', 120) &&
      optionalBool('ai_used') &&
      optionalString('release_id', 160) &&
      optionalString('redaction_contract', 240) &&
      optionalTimestampOrString('created_at');
    }

    function validRecordHistory(historyId) {
      return safeId(historyId) && (
        (
          request.resource.data.keys().hasOnly([
            'schema_version',
            'collection',
            'record_id',
            'operation',
            'created_at',
          ]) &&
          request.resource.data.schema_version == 1 &&
          request.resource.data.collection in ['active_drugs', 'intakes', 'meals'] &&
          safeId(request.resource.data.record_id) &&
          request.resource.data.operation in ['set', 'delete'] &&
          request.resource.data.created_at is timestamp &&
          request.resource.data.created_at == request.time
        ) ||
        validRecoverableEventHistory(historyId)
      );
    }

    function validMechanisticReplayCapsule(uid, capsuleSha256) {
      return capsuleSha256.matches('^[a-f0-9]{64}$') &&
        request.resource.data.keys().hasOnly([
          'schema_version',
          'capsule_sha256',
          'generated_at_utc',
          'canonical_json',
          'owner_uid',
        ]) &&
        request.resource.data.schema_version == 1 &&
        request.resource.data.capsule_sha256 == capsuleSha256 &&
        request.resource.data.owner_uid == uid &&
        request.resource.data.generated_at_utc is string &&
        request.resource.data.generated_at_utc.size() <= 40 &&
        request.resource.data.canonical_json is string &&
        request.resource.data.canonical_json.size() > 0 &&
        request.resource.data.canonical_json.size() <= 716800;
    }

    function validRecoverableEventHistory(historyDocumentId) {
      let revision = request.resource.data.revision;
      return request.resource.data.keys().hasOnly([
        'schema_version',
        'collection',
        'record_id',
        'operation',
        'operation_id',
        'before_digest',
        'after_digest',
        'revision',
        'created_at',
      ]) &&
      request.resource.data.schema_version == 1 &&
      request.resource.data.collection in ['intakes', 'meals'] &&
      safeId(request.resource.data.record_id) &&
      request.resource.data.operation in ['create', 'update', 'delete', 'restore'] &&
      safeId(request.resource.data.operation_id) &&
      request.resource.data.before_digest is string &&
      request.resource.data.before_digest.matches('^[a-f0-9]{64}$') &&
      request.resource.data.after_digest is string &&
      request.resource.data.after_digest.matches('^[a-f0-9]{64}$') &&
      request.resource.data.created_at is timestamp &&
      request.resource.data.created_at == request.time &&
      revision is map &&
      revision.keys().hasOnly([
        'schema_version',
        'history_id',
        'operation_id',
        'event_type',
        'record_id',
        'mutation_type',
        'before_payload',
        'after_payload',
        'before_digest',
        'after_digest',
        'recorded_at_utc',
        'source',
        'restores_history_id',
      ]) &&
      revision.schema_version == 1 &&
      revision.operation_id == historyDocumentId &&
      revision.operation_id == request.resource.data.operation_id &&
      revision.record_id == request.resource.data.record_id &&
      revision.mutation_type == request.resource.data.operation &&
      revision.before_digest == request.resource.data.before_digest &&
      revision.after_digest == request.resource.data.after_digest &&
      revision.event_type in ['meal', 'intake'] &&
      (
        (revision.event_type == 'meal' && request.resource.data.collection == 'meals') ||
        (revision.event_type == 'intake' && request.resource.data.collection == 'intakes')
      ) &&
      (revision.before_payload == null || (revision.before_payload is map && revision.before_payload.keys().size() <= 32)) &&
      (revision.after_payload == null || (revision.after_payload is map && revision.after_payload.keys().size() <= 32)) &&
      revision.recorded_at_utc is string && revision.recorded_at_utc.size() <= 80 &&
      revision.source is string && revision.source.size() > 0 && revision.source.size() <= 80 &&
      (revision.restores_history_id == null || safeId(revision.restores_history_id));
    }

    function validAppCatalogWrite(table, rowId) {
      return safeId(rowId) && (
        (table == 'foods' && validFoodCatalogRow(rowId)) ||
        (table == 'medications' && validMedicationCatalogRow(rowId)) ||
        (table == 'interaction_rules' && validInteractionRuleCatalogRow(rowId)) ||
        (table.matches('^live_probe.*$') && validLiveProbeCatalogRow())
      );
    }

    function validFoodCatalogRow(rowId) {
      return request.resource.data.keys().hasOnly([
        'id', 'name', 'category', 'aliases', 'description', 'sourceSystem',
        'sourceFoodCode', 'jurisdiction', 'textureClass', 'iddsiLevel',
        'proteinG', 'carbsG', 'fatG', 'fiberG', 'sodiumMg',
        'missingNutrientFields', 'energyKcal', 'waterG', 'aminoAcidProfile',
        'basisType', 'preparationState', 'qualifierKind', '_synced_at_ms'
      ]) &&
      validString('id', 160) &&
      request.resource.data.id == rowId &&
      validString('name', 240) &&
      validString('category', 64) &&
      optionalStringList('aliases', 64) &&
      optionalString('description', 1200) &&
      optionalString('sourceSystem', 120) &&
      optionalString('sourceFoodCode', 160) &&
      optionalString('jurisdiction', 32) &&
      optionalString('textureClass', 64) &&
      optionalNumber('iddsiLevel') &&
      optionalNumber('proteinG') &&
      optionalNumber('carbsG') &&
      optionalNumber('fatG') &&
      optionalNumber('fiberG') &&
      optionalNumber('sodiumMg') &&
      optionalStringList('missingNutrientFields', 32) &&
      optionalNumber('energyKcal') &&
      optionalNumber('waterG') &&
      optionalMap('aminoAcidProfile', 48) &&
      optionalString('basisType', 80) &&
      optionalString('preparationState', 120) &&
      optionalString('qualifierKind', 80) &&
      optionalNumber('_synced_at_ms');
    }

    function validMedicationCatalogRow(rowId) {
      return request.resource.data.keys().hasOnly([
        'id', 'genericName', 'brandNames', 'aliases', 'tags', 'notes',
        'interactionSummary', 'sourceSystem', 'sourceProductCode',
        'jurisdiction', 'route', 'dosageForm', 'releaseType', '_synced_at_ms'
      ]) &&
      validString('id', 160) &&
      request.resource.data.id == rowId &&
      validString('genericName', 240) &&
      optionalStringList('brandNames', 64) &&
      optionalStringList('aliases', 64) &&
      optionalStringList('tags', 32) &&
      optionalString('notes', 1200) &&
      optionalString('interactionSummary', 1200) &&
      optionalString('sourceSystem', 120) &&
      optionalString('sourceProductCode', 160) &&
      optionalString('jurisdiction', 32) &&
      optionalString('route', 80) &&
      optionalString('dosageForm', 120) &&
      optionalString('releaseType', 80) &&
      optionalNumber('_synced_at_ms');
    }

    function validInteractionRuleCatalogRow(rowId) {
      return request.resource.data.keys().hasOnly([
        'id', 'drugId', 'ruleType', 'target', 'severity', 'weight',
        'description', '_synced_at_ms'
      ]) &&
      validString('id', 160) &&
      request.resource.data.id == rowId &&
      validString('drugId', 160) &&
      validString('ruleType', 120) &&
      validString('target', 240) &&
      request.resource.data.severity is int &&
      optionalNumber('weight') &&
      optionalString('description', 1200) &&
      optionalNumber('_synced_at_ms');
    }

    function validLiveProbeCatalogRow() {
      return request.resource.data.keys().hasOnly(['probe']) &&
      validString('probe', 160);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;

      match /profile/{profileId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) &&
          profileId == 'current' &&
          validProfile(uid);
        allow delete: if false;
      }

      match /app_meta/{key} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validAppMeta(uid, key);
        allow delete: if false;
      }

      match /kv/{key} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validKv(key);
        allow delete: if isOwner(uid) && safeId(key);
      }

      match /active_drugs/{drugId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validActiveDrug(drugId);
        allow delete: if isOwner(uid) && safeId(drugId);
      }

      match /meals/{mealId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validMeal(mealId);
        allow delete: if isOwner(uid) && safeId(mealId);
      }

      match /intakes/{intakeId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validIntake(intakeId);
        allow delete: if isOwner(uid) && safeId(intakeId);
      }

      match /clinical_audits/{auditId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validClinicalAudit(uid, auditId);
        allow update, delete: if false;
      }

      match /record_history/{historyId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validRecordHistory(historyId);
        allow update, delete: if false;
      }

      match /mechanistic_replay_capsules/{capsuleSha256} {
        allow read: if isOwner(uid) && capsuleSha256.matches('^[a-f0-9]{64}$');
        allow create: if isOwner(uid) &&
          validMechanisticReplayCapsule(uid, capsuleSha256);
        allow update, delete: if false;
      }

      match /cdss_tables/{table}/rows/{rowId} {
        allow read: if isOwner(uid) && safeId(table) && safeId(rowId);
        allow write: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /app_catalog/{table}/rows/{rowId} {
      allow read: if signedIn();
      allow write: if isAdminOrImporter() &&
        validAppCatalogWrite(table, rowId);
    }

    match /cdss_tables/{table}/rows/{rowId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
